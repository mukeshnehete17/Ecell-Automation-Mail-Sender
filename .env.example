# Copy to .env.local for local development. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact URI in the Google Cloud OAuth client ("Authorized redirect URIs").
# NextAuth derives the redirect URI from NEXTAUTH_URL; keep both in sync.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
